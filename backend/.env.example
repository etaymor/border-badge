# Backend Environment Configuration
# Copy this file to .env and fill in your values

# Environment
ENV=development
DEBUG=true

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# OpenRouter Configuration (for traveler classification)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemini-flash-2.5-lite

# Google Analytics 4 (Optional)
# GA4 Measurement ID for public pages (landing, shared lists/trips)
# Get your ID from: https://analytics.google.com/ > Admin > Data Streams
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Affiliate links format
AFFILIATE_SIGNING_SECRET=
SKIMLINKS_API_KEY=
SKIMLINKS_PUBLISHER_ID=

# Social Ingest Configuration
# Instagram oEmbed API token (Meta App Access Token)
# Get from: https://developers.facebook.com/apps/ > Your App > Settings > Basic
INSTAGRAM_OEMBED_TOKEN=

# Google Places API key (for place extraction from social content)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=

# Google Maps JS API (public share pages: /l/{slug}, /t/{slug})
# This key is embedded in the served HTML, so it MUST be a separate,
# browser-restricted key (Credentials > Application restrictions > HTTP referrers)
# with only "Maps JavaScript API" enabled. Do NOT reuse GOOGLE_PLACES_API_KEY.
GOOGLE_MAPS_BROWSER_API_KEY=

# Cloud-styled Map ID for the share-page maps. Required by Advanced Markers.
# Create at: https://console.cloud.google.com/google/maps-apis/studio/maps
GOOGLE_MAPS_MAP_ID=

# Google Places API settings (optional - defaults shown)
# Timeout for single API request in seconds
PLACES_API_TIMEOUT_SECONDS=5.0
# Timeout per cluster (includes retries) in seconds
PLACES_CLUSTER_TIMEOUT_SECONDS=15.0

# Photo-import vision classification concurrency (U12).
# Max concurrent vision (OpenRouter) calls ONE suggest-places request may have
# in flight. A full batch is 5 clusters x up to 3 images = 15 images, so at the
# default of 5 a batch costs three sequential concurrency waves.
#
#   Single-wave value: VISION_MAX_CONCURRENT_REQUESTS=15
#
# Setting 15 classifies a full batch in ONE wave. It buys no extra API calls
# and no extra spend — the same work, differently scheduled. Set it ONLY after
# reading the vision-vs-search split off the `place_matcher_phase_metrics` log
# line (compare `vision.total_ms` and `phase_ms.vision_wait` against
# `phase_ms.search`); if the vision wait is not materially above the search
# time, widening this buys nothing and the default should stand. Watch
# `vision.null_reasons.timeout` after any change — a rise there means the
# widening is trading latency for lost ranking signal.
# A process-wide ceiling (30) applies across concurrent requests regardless.
VISION_MAX_CONCURRENT_REQUESTS=5

# PostHog Analytics (optional - for LLM accuracy tracking)
# Use the same project API key as the mobile app
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# TikTok proxy (optional - residential proxy for TikTok requests)
TIKTOK_PROXY_URL=

REVENUECAT_WEBHOOK_AUTH_HEADER=
REVENUECAT_API_KEY=<your-secret-api-key-from-RevenueCat>

# Facebook Conversions API (for server-side ad event tracking)
# Get your Pixel ID and access token from: https://business.facebook.com/events_manager
FACEBOOK_PIXEL_ID=
FACEBOOK_CAPI_ACCESS_TOKEN=

# TikTok Events API (for server-side ad event tracking)
# Get your access token and pixel code from: https://ads.tiktok.com/
TIKTOK_EVENTS_ACCESS_TOKEN=
TIKTOK_PIXEL_CODE=
