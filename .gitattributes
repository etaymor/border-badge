# Git LFS - Large File Storage
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text

# Exclude backend static files from LFS (needed for Railway deployment)
backend/app/static/**/*.png !filter !diff !merge text=auto
backend/app/static/**/*.jpg !filter !diff !merge text=auto
backend/app/static/**/*.jpeg !filter !diff !merge text=auto
backend/app/static/**/*.webp !filter !diff !merge text=auto
